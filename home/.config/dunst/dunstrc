[global]
    monitor = 0
    follow = mouse
    width = 350
    height = 150
    origin = top-right
    offset = 10x40
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#88c0d0"
    separator_color = frame
    corner_radius = 8
    font = CaskaydiaCove Nerd Font 10
    icon_position = left
    max_icon_size = 48
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#2e3440"
    foreground = "#d8dee9"
    timeout = 4

[urgency_normal]
    background = "#2e3440"
    foreground = "#eceff4"
    timeout = 6

[urgency_critical]
    background = "#3b4252"
    foreground = "#eceff4"
    frame_color = "#bf616a"
    timeout = 0
