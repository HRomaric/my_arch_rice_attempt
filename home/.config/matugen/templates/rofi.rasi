/* Generated by matugen from the wallpaper. Edit ~/.config/matugen/templates/rofi.rasi instead. */
* {
    background:                  {{colors.surface.default.rgba | set_alpha: 0.88}};
    foreground:                  {{colors.on_surface.default.hex}};
    foreground-dim:              {{colors.outline.default.hex}};

    active-background:           {{colors.secondary_container.default.hex}};
    active-foreground:           {{colors.on_secondary_container.default.hex}};
    urgent-background:           {{colors.error.default.hex}};
    urgent-foreground:           {{colors.on_error.default.hex}};
    accent:                      {{colors.primary.default.hex}};
    on-accent:                   {{colors.on_primary.default.hex}};
    arch-color:                  {{colors.primary.default.hex}};

    selected-background:         @accent;
    selected-urgent-background:  @urgent-background;
    selected-active-background:  @active-background;
    separatorcolor:              @active-background;
    bordercolor:                 @active-background;
}
